# The keys `make bootstrap` writes to .env (scripts/gen-env.sh). You don't copy this file: bootstrap
# creates .env with random development values and keeps them on every re-run. Never put a real secret
# in .env.

# Generated: local development credentials for the infrastructure services.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
MEILI_MASTER_KEY=

# Optional, never generated: your own Authorize.Net sandbox credentials. Leave them empty to run the
# platform without payments.
AUTHORIZE_NET_API_LOGIN_ID=
AUTHORIZE_NET_TRANSACTION_KEY=
